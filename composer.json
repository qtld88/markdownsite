{
    "name": "qtl/markdownsite",
    "description": "Browse a folder of Markdown as a read-only wiki inside Nextcloud",
    "type": "project",
    "license": "AGPL-3.0-or-later",
    "require": {
        "php": ">=8.1",
        "league/commonmark": "^2.4",
        "symfony/yaml": "^6.4 || ^7.0"
    },
    "require-dev": {
        "nextcloud/ocp": "^34.0",
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "OCA\\MarkdownSite\\": "lib/",
            "OCP\\": "vendor/nextcloud/ocp/OCP/"
        }
    },
    "autoload-dev": {
        "psr-4": { "OCA\\MarkdownSite\\Tests\\": "tests/" }
    },
    "scripts": {
        "lint": "php -l lib/",
        "test": "phpunit"
    },
    "config": { "platform": { "php": "8.1" }, "sort-packages": true }
}
